---
import { Icon } from 'astro-icon/components';

const { platform, username, icon } = Astro.props;

const profiles: Record<string, { host: string; label: string }> = {
	github: { host: 'github.com', label: 'GitHub' },
	linkedin: { host: 'www.linkedin.com', label: 'LinkedIn' },
};

const profile = profiles[platform];
const href = `https://${profile.host}/${username}`;
---

<a
	class="inline-block py-2 text-4xl text-gray-900 no-underline hover:scale-110 focus:scale-110 dark:text-gray-50"
	href={href}
	aria-label={profile.label}
	rel="noopener noreferrer"
>
	<Icon name={icon} aria-hidden="true" />
</a>
