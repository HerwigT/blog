---
import Wordmark from './Wordmark.astro';

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

const isCurrent = (href: string) => {
	const target = href.endsWith('/') ? href : `${href}/`;
	if (target === '/') return path === '/';
	return path.startsWith(target);
};

const editionDate = new Intl.DateTimeFormat('en-GB', {
	weekday: 'long',
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'Europe/Vienna',
}).format(new Date());

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/blog/', label: 'Blog' },
	{ href: '/til/', label: 'TIL' },
	{ href: '/about/', label: 'About' },
];
---

<header class="border-b border-current text-ink dark:text-ink-dark">
	<div class="mx-auto max-w-6xl px-4 pb-2 pt-5 text-center sm:pt-7">
		<p class="kicker">Vienna</p>
		<a href="/" class="mx-auto mt-3 block w-full max-w-[40rem]">
			<Wordmark />
			<span class="sr-only">Herwig Teufer</span>
		</a>
		<p class="motto mt-3 text-muted dark:text-muted-dark">Data Engineer · Bouldering Enthusiast · Hobby Blogger</p>
	</div>
	<div class="mx-auto max-w-6xl px-4">
		<div class="rule-double" aria-hidden="true"></div>
		<p class="flex flex-wrap items-baseline justify-center gap-x-5 gap-y-1 py-2 text-center text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-muted sm:justify-between dark:text-muted-dark">
			<span>{editionDate}</span>
			<span>Personal edition</span>
			<span>teufer.dev</span>
		</p>
		<div class="border-t border-current"></div>
		<nav class="flex flex-wrap items-center justify-center" aria-label="Primary">
			{
				links.map((link) => (
					<a
						class="nav-link"
						href={link.href}
						aria-current={isCurrent(link.href) ? 'page' : undefined}
					>
						{link.label}
					</a>
				))
			}
			<a class="nav-link" href="/rss.xml">RSS</a>
		</nav>
	</div>
</header>
