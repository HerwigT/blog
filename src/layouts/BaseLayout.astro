---
import Header from '../components/Header.astro';
import { siteDescription, siteName } from '../data/site';
import '../styles/global.css';

const {
	pageTitle,
	description = siteDescription,
	ogType = 'website',
	publishedTime,
	author,
} = Astro.props;

const title = pageTitle && pageTitle !== siteName ? `${pageTitle} · ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/og.png', Astro.site);
const year = new Date().getFullYear();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{author && <meta name="author" content={author} />}
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="application/rss+xml" title={siteName} href={new URL('/rss.xml', Astro.site)} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="en" />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Herwig Teufer, data engineer in Vienna" />
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<meta name="twitter:image:alt" content="Herwig Teufer, data engineer in Vienna" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-gray-50 text-gray-900 dark:bg-gray-900 dark:text-gray-50">
		<a
			href="#content"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-gray-50 focus:px-4 focus:py-2 focus:text-gray-900 dark:focus:bg-gray-800 dark:focus:text-gray-50"
		>
			Skip to content
		</a>
		<Header />
		<main id="content" tabindex="-1" class="mx-auto max-w-3xl px-4 py-8 text-lg">
			<slot />
		</main>
		<footer class="border-t border-gray-200 dark:border-gray-700">
			<div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-3 px-4 py-6 text-sm text-gray-600 dark:text-gray-400">
				<p class="py-0">© {year} {siteName}</p>
				<a class="underline underline-offset-2" href="/rss.xml">RSS feed</a>
			</div>
		</footer>
	</body>
</html>
