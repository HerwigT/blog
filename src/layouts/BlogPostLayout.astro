---
import BaseLayout from './BaseLayout.astro';
import { formatDate, isoDate } from '../data/site';

const { frontmatter } = Astro.props;
const published = isoDate(frontmatter.pubDate);
const tags = frontmatter.tags ?? [];
---

<BaseLayout
	pageTitle={frontmatter.title}
	description={frontmatter.description}
	ogType="article"
	publishedTime={published}
	author={frontmatter.author}
>
	<article class="mx-auto max-w-[38rem]">
		{
			tags.length > 0 && (
				<p class="kicker">
					{tags.map((tag: string, index: number) => (
						<>
							{index > 0 && <span aria-hidden="true"> · </span>}
							<a class="hover:underline" href={`/tags/${encodeURIComponent(tag)}/`}>
								{tag}
							</a>
						</>
					))}
				</p>
			)
		}
		<h1 class="headline mt-3 text-[2.15rem] sm:text-5xl">{frontmatter.title}</h1>
		<p class="dateline mt-4">
			<time datetime={published}>{formatDate(frontmatter.pubDate)}</time>
			<span aria-hidden="true"> · </span>
			{frontmatter.author}
			<span aria-hidden="true"> · </span>
			Vienna
		</p>
		<div class="mt-4 border-t border-current"></div>
		<div class="prose mt-6">
			<slot />
		</div>
		{
			tags.length > 0 && (
				<div class="mt-10 border-t border-current pt-4">
					<p class="kicker">Sections</p>
					<ul class="mt-3 flex list-none flex-wrap gap-x-4 gap-y-2 p-0">
						{tags.map((tag: string) => (
							<li>
								<a class="kicker hover:underline" href={`/tags/${encodeURIComponent(tag)}/`}>
									{tag}
								</a>
							</li>
						))}
					</ul>
				</div>
			)
		}
		<p class="mt-8">
			<a class="underline underline-offset-4" href="/blog/">Back to the blog</a>
		</p>
	</article>
</BaseLayout>
