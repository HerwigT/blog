---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css'

const pageTitle = "Herwig Teufer";
const identity = {
    firstName : "Herwig",
    city: "Vienna",
    country: "Austria",
    occupation: "Data Engineer | Computer Vision Engineer",
    hobbies: ["bouldering", "hiking", "cooking", "gaming", "reading"]
};
const techs = ["Python - data engineering and machine learning", "SQL - Postgres", "C# - WPF - Entity Framework", 'Azure - Azure Functions - Azure Machine Learning'];
const education = [
    ["Medical University Vienna - Medical Computer Science - Master", "2021-2024", "Masterthesis: Domain-Disentangled Anomaly Detection in Thorax Computed Tomography Images using Deep Learning.", "https://repositorium.meduniwien.ac.at/obvumwhs/content/titleinfo/10431263"], 
    ["TU Vienna - Medical Computer Science - Bachelor", "2017-2020", "Bachelorthesis: Appointment Management in the Outpatient Sector: Analysis, Design, and Prototype Implementation."]
]
const companies = [
    ["Becton Dickinson (BD) - Data Engineer", "2023-20XX", 
    "Built a robust ETL data pipeline handling ingestion, transformation, and storage of large-scale image datasets and metadata, ensuring data quality and consistency across international environments.", 
    "Led the recruitment, onboarding, and mentorship of data science interns, including candidate interviews, selection, and ongoing technical guidance.",
    "Owned data strategy and communication within the project - identified data needs and sources, facilitated access for data scientists, and translated complex findings into actionable insights for project leads."
    ], 
    ["ace Neue Informationstechnologien GmbH - Software Developer", "2021-2023", 
    "Developed and customized Microsoft Dynamics 365 solutions using C#, TypeScript, and Entity Framework, implementing custom actions and extensions to enhance business workflows.", 
    "Built a financial data ingestion tool to transfer and synchronize data from Dynamics 365 into clients’ personal finance management systems, improving data accuracy and automation.", 
    "Designed and implemented a custom marketing module replacing Dynamics 365’s native functionality, supporting automated email templates and document generation ('Serienbriefe')."],
    ["Leitner Messtechnische Dienstleistungen - Studentjob", "2018-2021"]
]
---
<BaseLayout pageTitle = {pageTitle}>
    <h1 class="text-center">{pageTitle}</h1>
    <hr class="my-4">
    <h2 class="text-center">{identity.occupation}</h2>
    <hr class="my-4">
    <h1 class="text-center">Work experience</h1>
    {companies.map((entry) =>
        <div class="justify-between flex">
            <p>{entry[0]}</p>
            <p>{entry[1]}</p>
        </div>
        <ul>
            {entry.slice(2).map((skill) => <li class="text-sm list-disc mx-6">{skill}</li>)}
        </ul>
    )}
    
    <hr class="my-4">
    <h1 class="text-center">Education</h1>
    {education.map((entry) =>
        <div class="justify-between flex">
            <p>{entry[0]}</p>
            <p>{entry[1]}</p>
        </div>
        <div class="text-sm">
            {entry[2]}{entry[3] && <a href=`${entry[3]}` target="_blank"> 🔗</a>}
        </div>
    )}
    <hr class="my-4">
    <h1 class="text-center">Tech Stack</h1>
    <ul class="flex flex-wrap gap-2">
        {techs.map((tech) => <li class="bg-gray-200 dark:bg-gray-700 rounded-full px-3 py-1 text-sm font-semibold text-gray-700 dark:text-gray-200">{tech}</li>)}
    </ul>
</BaseLayout>
