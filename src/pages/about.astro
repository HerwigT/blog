---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'About';
const identity = {
	occupation: 'Data Engineer | Computer Vision Engineer',
};
const techs = [
	'Python - data engineering and machine learning',
	'SQL - Postgres',
	'C# - WPF - Entity Framework',
	'Azure - Azure Functions - Azure Machine Learning',
];
const education = [
	[
		'Medical University Vienna - Medical Computer Science - Master',
		'2021-2024',
		'Masterthesis: Domain-Disentangled Anomaly Detection in Thorax Computed Tomography Images using Deep Learning.',
		'https://repositorium.meduniwien.ac.at/obvumwhs/content/titleinfo/10431263',
	],
	[
		'TU Vienna - Medical Computer Science - Bachelor',
		'2017-2020',
		'Bachelorthesis: Appointment Management in the Outpatient Sector: Analysis, Design, and Prototype Implementation.',
	],
];
const companies = [
	[
		'Becton Dickinson (BD) - Data Engineer',
		'2023-20XX',
		'Built a robust ETL data pipeline handling ingestion, transformation, and storage of large-scale image datasets and metadata, ensuring data quality and consistency across international environments.',
		'Led the recruitment, onboarding, and mentorship of data science interns, including candidate interviews, selection, and ongoing technical guidance.',
		'Owned data strategy and communication within the project - identified data needs and sources, facilitated access for data scientists, and translated complex findings into actionable insights for project leads.',
	],
	[
		'ace Neue Informationstechnologien GmbH - Software Developer',
		'2021-2023',
		'Developed and customized Microsoft Dynamics 365 solutions using C#, TypeScript, and Entity Framework, implementing custom actions and extensions to enhance business workflows.',
		'Built a financial data ingestion tool to transfer and synchronize data from Dynamics 365 into clients’ personal finance management systems, improving data accuracy and automation.',
		'Designed and implemented a custom marketing module replacing Dynamics 365’s native functionality, supporting automated email templates and document generation (\'Serienbriefe\').',
	],
	['Leitner Messtechnische Dienstleistungen - Studentjob', '2018-2021'],
];
---

<BaseLayout
	pageTitle={pageTitle}
	description="Work, education, and tools. Herwig Teufer is a data engineer in Vienna."
>
	<header class="mx-auto max-w-3xl border-b border-current pb-6 text-center">
		<p class="kicker">Profile</p>
		<h1 class="headline mt-2 text-5xl">Herwig Teufer</h1>
		<p class="deck mt-3">{identity.occupation}</p>
	</header>

	<div class="mx-auto max-w-3xl">
		<section class="mt-10">
			<h2 class="kicker">Work experience</h2>
			{
				companies.map((entry) => {
					const [role, dates, ...points] = entry;
					return (
						<section class="mt-6 border-t border-current pt-4">
							<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
								<h3 class="headline text-xl">{role}</h3>
								<p class="dateline shrink-0">{dates}</p>
							</div>
							{points.length > 0 && (
								<ul class="mt-3 list-disc space-y-1 pl-5 text-base leading-relaxed">
									{points.map((point) => (
										<li>{point}</li>
									))}
								</ul>
							)}
						</section>
					);
				})
			}
		</section>

		<section class="mt-12">
			<h2 class="kicker">Education</h2>
			{
				education.map((entry) => (
					<section class="mt-6 border-t border-current pt-4">
						<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
							<h3 class="headline text-xl">{entry[0]}</h3>
							<p class="dateline shrink-0">{entry[1]}</p>
						</div>
						<p class="mt-2 text-base leading-relaxed">
							{entry[2]}
							{entry[3] && (
								<>
									{' '}
									<a class="underline underline-offset-4" href={entry[3]} target="_blank" rel="noopener noreferrer">
										Read thesis<span class="sr-only"> (opens in a new tab)</span>
									</a>
								</>
							)}
						</p>
					</section>
				))
			}
		</section>

		<section class="mt-12">
			<h2 class="kicker">Tech stack</h2>
			<ul class="mt-4 list-none space-y-1 p-0 text-base">
				{techs.map((tech) => <li class="border-t border-current py-2">{tech}</li>)}
			</ul>
		</section>
	</div>
</BaseLayout>
