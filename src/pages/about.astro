---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css'

const pageTitle = "About Me";
const identity = {
    firstName : "Herwig",
    city: "Vienna",
    country: "Austria",
    occupation: "Data Engineer",
    hobbies: ["bouldering", "hiking", "cooking", "gaming", "reading"]
};
const skills = ["Python", "Machine Learning", "Data Engineering"];
const education = [["Medical University Vienna - Medical Computer Science - Master", "2021-2024"], ["TU Vienna - Medical Computer Science - Bachelor", "2017-2020"]]
const experience = [["BD - Data Engineer", "2023-20XX"], ["ace Neue Informationstechnologien GmbH - Software Developer", "2021-2023"]]
---
<BaseLayout pageTitle = {pageTitle}>
    <h1>{pageTitle}</h1>
    <ul>
        <li>My name is {identity.firstName}.</li>
        <li>I live in {identity.city} ({identity.country}) and I work as a {identity.occupation}.</li>
        {identity.hobbies.length >= 2 &&
            <li>Two of my hobbies are: {identity.hobbies[0]} and {identity.hobbies[1]}</li>
        }
    </ul>

    <h2>Work experience</h2>
    {experience.map((entry) =><div class="justify-between flex"><p>{entry[0]}</p><p>{entry[1]}</p></div>)}
    <h2>Skills</h2>
    <ul>
        {skills.map((skill) => <li class="skill">{skill}</li>)}
    </ul>

    <h2>Education</h2>
    {education.map((entry) =><div class="justify-between flex"><p>{entry[0]}</p><p>{entry[1]}</p></div>)}
</BaseLayout>
