---
import { getPosts } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Tags';
const allPosts = getPosts(import.meta.glob('../posts/*.md', { eager: true }));
const uniqueTags = [...new Set(allPosts.flatMap((post) => post.frontmatter.tags ?? []))].sort((a, b) =>
	a.localeCompare(b),
);
---

<BaseLayout pageTitle={pageTitle} description="Posts grouped by topic.">
	<header class="mx-auto max-w-3xl text-center">
		<p class="kicker">Index</p>
		<h1 class="headline mt-2 text-5xl">Tags</h1>
		<p class="deck mt-3">Click on a tag to list all blogs with this tag.</p>
	</header>
	<ul class="mx-auto mt-10 flex max-w-3xl list-none flex-wrap justify-center gap-x-6 gap-y-4 p-0">
		{
			uniqueTags.map((tag) => (
				<li>
					<a class="kicker text-base hover:underline" href={`/tags/${encodeURIComponent(tag)}/`}>
						{tag}
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>
