---
import BaseLayout from "../../layouts/BaseLayout.astro"
const pageTitle = "Tag Index"

const allPosts = Object.values(import.meta.glob('../posts/*.md', {eager: true}));
const uniqueTags = [...new Set(allPosts.map((post:any) => post.frontmatter.tags).flat())];
---
<BaseLayout pageTitle={pageTitle}>
    <h1>Tag Overview</h1>
    <h3>Click on a tag to list all blogs with this tag:</h3>
    <div class="flex flex-wrap my-4 gap-2">
        {uniqueTags.map((tag) => (
            <a href={`/tags/${tag}`} class="bg-gray-200 dark:bg-gray-700 rounded-full px-4 py-2 text-sm font-semibold text-gray-700 dark:text-gray-200 hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors duration-300">{tag}</a>
        ))}
    </div>
</BaseLayout>