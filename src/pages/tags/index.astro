---
import BaseLayout from "../../layouts/BaseLayout.astro"
const pageTitle = "Tag Index"

const allPosts = Object.values(import.meta.glob('../posts/*.md', {eager: true}));
const uniqueTags = [...new Set(allPosts.map((post:any) => post.frontmatter.tags).flat())];
---
<BaseLayout pageTitle={pageTitle}>
    <h1>Tag Overview</h1>
    <h3>Click on a tag to list all blogs with this tag:</h3>
    <div class="flex flex-wrap my-4">
        {uniqueTags.map((tag) => (
            <p class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-50 text-xl mx-1 px-4 py-2 border-1 border-dotted rounded-lg"><a href={`/tags/${tag}`}>{tag}</a></p>
        ))}
    </div>
</BaseLayout>