---
import { getPosts } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Tags';
const allPosts = getPosts(import.meta.glob('../posts/*.md', { eager: true }));
const uniqueTags = [...new Set(allPosts.flatMap((post) => post.frontmatter.tags ?? []))].sort((a, b) =>
	a.localeCompare(b),
);
---

<BaseLayout pageTitle={pageTitle} description="Posts grouped by topic.">
	<h1>Tags</h1>
	<p>Click on a tag to list all blogs with this tag:</p>
	<ul class="my-4 flex list-none flex-wrap gap-2 p-0">
		{
			uniqueTags.map((tag) => (
				<li>
					<a
						href={`/tags/${encodeURIComponent(tag)}/`}
						class="rounded-full bg-gray-200 px-4 py-2 text-sm font-semibold text-gray-700 no-underline transition-colors duration-300 hover:bg-gray-300 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600"
					>
						{tag}
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>
