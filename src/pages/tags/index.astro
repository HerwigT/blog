---
import { getPosts, getTils, taggedEntries, tagsWithCounts } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Tags';
const posts = getPosts(import.meta.glob('../posts/*.md', { eager: true }));
const tils = getTils(import.meta.glob('../til/*.md', { eager: true }));
const tags = tagsWithCounts(taggedEntries(posts, tils));
---

<BaseLayout pageTitle={pageTitle} description="Posts and TILs grouped by topic.">
	<header class="mx-auto max-w-3xl text-center">
		<p class="kicker">Index</p>
		<h1 class="headline mt-2 text-5xl">Tags</h1>
		<p class="deck mt-3">Each tag lists the posts and TILs that use it.</p>
	</header>
	<ul class="tag-index">
		{
			tags.map(({ tag, count }) => (
				<li>
					<a href={`/tags/${encodeURIComponent(tag)}/`}>
						<span class="kicker">{tag}</span>
						<span class="tag-leader" aria-hidden="true"></span>
						<span class="tag-count">{count}</span>
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>
