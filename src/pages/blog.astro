---
import BlogPost from '../components/BlogPost.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css'
const allPosts = Object.values(import.meta.glob('./posts/*.md', {eager: true}));
const pageTitle = "Blogposts";
---

<BaseLayout pageTitle = {pageTitle}>
	<div class="text-center mb-8">
		<h1 class="text-4xl font-bold mb-4">{pageTitle}</h1>
		<p class="text-lg text-gray-600 dark:text-gray-400">Welcome to my corner of the internet. Here are some things I've written.</p>
	</div>
	<div class="text-center mb-12">
		<a href="/tags/" class="inline-block border-2 border-blue-500 dark:border-amber-400 text-blue-500 dark:text-amber-400 font-bold py-2 px-6 rounded-full hover:bg-blue-500 dark:hover:bg-amber-400 hover:text-white dark:hover:text-gray-900 transition-colors duration-300">
			Explore Tags
		</a>
	</div>
	<ul>
		{allPosts.map((post: any) => <BlogPost post={post} />)}
	</ul>
</BaseLayout>
