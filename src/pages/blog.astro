---
import BlogPost from '../components/BlogPost.astro';
import { getPosts } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = getPosts(import.meta.glob('./posts/*.md', { eager: true }));
const pageTitle = 'Blog';
---

<BaseLayout pageTitle={pageTitle} description="Essays and notes by Herwig Teufer.">
	<div class="mb-8 text-center">
		<h1 class="mb-4 text-4xl font-bold">{pageTitle}</h1>
		<p class="text-lg text-gray-600 dark:text-gray-400">Welcome to my corner of the internet. Here are some things I've written.</p>
	</div>
	<div class="mb-12 text-center">
		<a
			href="/tags/"
			class="inline-block rounded-full border-2 border-blue-500 px-6 py-2 font-bold text-blue-500 transition-colors duration-300 hover:bg-blue-500 hover:text-white dark:border-amber-400 dark:text-amber-400 dark:hover:bg-amber-400 dark:hover:text-gray-900"
		>
			Explore Tags
		</a>
	</div>
	<ul class="list-none p-0">
		{
			allPosts.map((post) => (
				<li>
					<BlogPost post={post} />
				</li>
			))
		}
	</ul>
</BaseLayout>
