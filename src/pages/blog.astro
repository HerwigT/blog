---
import Story from '../components/Story.astro';
import { getPosts } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = getPosts(import.meta.glob('./posts/*.md', { eager: true }));
const [featured, ...rest] = allPosts;
const pageTitle = 'Blog';
---

<BaseLayout pageTitle={pageTitle} description="Essays and notes by Herwig Teufer.">
	<header class="mx-auto mb-10 max-w-3xl border-b border-current pb-6 text-center">
		<p class="kicker">Section</p>
		<h1 class="headline mt-2 text-5xl sm:text-6xl">{pageTitle}</h1>
		<p class="deck mt-3">Welcome to my corner of the internet. Here are some things I've written.</p>
	</header>

	{
		featured && (
			<div class="mx-auto max-w-3xl">
				<Story post={featured} featured={true} />
			</div>
		)
	}

	{
		rest.length > 0 && (
			<div class="story-grid mt-12 border-t border-current pt-8">
				{rest.map((post) => (
					<Story post={post} />
				))}
			</div>
		)
	}

	{
		allPosts.length === 0 && <p class="text-center">No posts yet.</p>
	}

	<p class="mt-12 text-center">
		<a class="kicker hover:underline" href="/tags/">Browse tags</a>
	</p>
</BaseLayout>
