---
import { formatDate, getTils, isoDate } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

const tils = getTils(import.meta.glob('./*.md', { eager: true }));
---

<BaseLayout
	pageTitle="Small Print"
	description="Short notes on things I picked up along the way."
	extraFeed={{ title: 'Herwig Teufer · Small Print', href: '/til/rss.xml' }}
>
	<header class="mx-auto mb-10 max-w-3xl border-b border-current pb-6 text-center">
		<p class="kicker">Section</p>
		<h1 class="headline mt-2 text-5xl sm:text-6xl">Today I Learned</h1>
		<p class="deck mt-3">Short notes on things I picked up along the way.</p>
		<p class="mt-4 text-base">
			<a class="underline underline-offset-4" href="/til/rss.xml">TIL feed</a>
		</p>
	</header>
	<div class="til-stream mx-auto max-w-3xl">
		{
			tils.map((til) => {
				const { Content } = til;
				const published = isoDate(til.frontmatter.pubDate);
				return (
					<article class="border-t border-current py-8 first:border-t-0 first:pt-0">
						{til.frontmatter.tags?.[0] && (
							<p class="kicker">
								<a
									class="text-inherit no-underline hover:underline"
									href={`/tags/${encodeURIComponent(til.frontmatter.tags[0])}/`}
								>
									{til.frontmatter.tags[0]}
								</a>
							</p>
						)}
						<h2 class="headline mt-2 text-3xl">
							<a href={til.url}>{til.frontmatter.title}</a>
						</h2>
						<p class="dateline mt-3">
							<time datetime={published}>{formatDate(til.frontmatter.pubDate)}</time>
						</p>
						<div class="mt-4">
							<Content />
						</div>
					</article>
				);
			})
		}
	</div>
	{tils.length === 0 && <p>No notes yet.</p>}
</BaseLayout>
