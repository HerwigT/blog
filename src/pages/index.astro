---
import Story from '../components/Story.astro';
import { excerpt, formatDate, getPosts, getTils, isoDate } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Herwig Teufer';
const posts = getPosts(import.meta.glob('./posts/*.md', { eager: true }));
const [lead, ...rest] = posts;
const [latestTil] = getTils(import.meta.glob('./til/*.md', { eager: true }));
---

<BaseLayout pageTitle={pageTitle}>
	<div class="front">
		<div class="front-lead">
			{
				lead ? (
					<Story post={lead} heading="h1" featured={true} />
				) : (
					<h1 class="headline text-4xl">Hi, I'm Herwig!</h1>
				)
			}
		</div>
		<aside class="front-rail">
			<p class="kicker">The writer</p>
			<h2 class="headline mt-2 text-3xl">Hi, I'm Herwig!👋</h2>
			<div class="mt-4 space-y-4 text-[1.05rem] leading-relaxed">
				<p>
					With about four years of hands-on experience in the tech world, I've grown from building solutions as a C#
					developer with Microsoft Dynamics to specializing in data engineering for Computer Vision projects. Alongside my
					technical focus, I have the rewarding role of interviewing and mentoring interns, helping guide their growth
					throughout their journey in our team.
				</p>
				<p>
					Outside of work, you’ll often find me exploring new topics in programming and AI or venturing outdoors for hiking
					and bouldering sessions.
				</p>
			</div>
			{
				latestTil && (
					<div class="mt-8 border-t border-current pt-5">
						<p class="kicker">Featured</p>
						<h3 class="headline mt-2 text-2xl">
							<a class="underline underline-offset-4" href={latestTil.url}>
								{latestTil.frontmatter.title}
							</a>
						</h3>
						<p class="dateline mt-2">
							<time datetime={isoDate(latestTil.frontmatter.pubDate)}>{formatDate(latestTil.frontmatter.pubDate)}</time>
						</p>
						<p class="mt-2 text-base leading-relaxed text-muted dark:text-muted-dark">{excerpt(latestTil.rawContent())}</p>
						<p class="mt-3">
							<a class="underline underline-offset-4" href="/til/">
								All TILs →
							</a>
						</p>
					</div>
				)
			}
		</aside>
	</div>

	{
		rest.length > 0 && (
			<section class="mt-12 border-t border-current pt-8">
				<h2 class="kicker">Also in this edition</h2>
				<div class="story-grid mt-6">
					{rest.map((post) => (
						<Story post={post} />
					))}
				</div>
			</section>
		)
	}
</BaseLayout>
